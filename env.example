# Caixa dedicada (ex: Gmail criado só pra receber os e-mails da clínica)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=aso.ability@gmail.com
IMAP_APP_PASSWORD=            # senha de app do Gmail (não é a senha normal da conta)

# Chave da conta de serviço do Firebase, em uma linha só (JSON inteiro como string)
# Gerar em: Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT=

# Segredo usado pra proteger o endpoint /api/sync (a Vercel usa isso automaticamente
# no cron quando a variável CRON_SECRET está configurada no projeto)
CRON_SECRET=

# Chave de criptografia dos ASOs (AES-256-GCM, 32 bytes em hexadecimal = 64 caracteres).
# Gerar uma vez com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde essa chave em um lugar seguro fora do repositório — se perder, os ASOs já
# salvos ficam ilegíveis pra sempre.
ASO_ENCRYPTION_KEY=

# Domínio onde o painel está hospedado, pra travar o CORS do endpoint /api/aso
# (ex: https://controle-aso-48c88.web.app). Sem isso, qualquer site pode chamar o endpoint.
PAINEL_ORIGIN=

# Cloudflare R2 — onde o PDF criptografado do ASO fica guardado (10GB grátis, sem cartão).
# R2_ACCOUNT_ID: painel da Cloudflare, barra lateral direita da conta.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 > Manage API Tokens > Create API Token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=asos-ability
